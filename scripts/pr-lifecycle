#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib/github-auth-preflight.sh
source "$script_dir/lib/github-auth-preflight.sh"

# Lifecycle ownership is derived from immutable GitHub reads. Classify a
# restricted-context auth failure as indeterminate before Node fetches the PR,
# rather than letting it become a false missing-PR or routing blocker. The
# caller may rerun this same read-only command in authorized host context.
export OPENCLAW_GITHUB_GH_BIN="${OPENCLAW_PR_LIFECYCLE_GH:-gh}"
openclaw_github_preflight "${OPENCLAW_GITHUB_CONTEXT:-restricted}" host-gh

exec node "$script_dir/pr-lifecycle.mjs" "$@"
